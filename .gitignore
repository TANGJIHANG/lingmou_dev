# ── 环境 ──────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/

# ── 数据与模型产物：内容绝不进 Git ─────────────────────
# 大文件走团队共享盘，文件名 + SHA256 记在 artifacts/README.md
# 注意：必须用 data/* 而不是 data/，否则目录内的 README/.gitkeep 也会被忽略，
#       新克隆下来就没有目录结构，"raw 只读"等约定也随之丢失。
data/*
!data/README.md
!data/.gitkeep
!data/*/.gitkeep
# DATA_SOURCES.md 是"来源 + 许可 + SHA256"的登记表，本身是文本证据，
# 必须进 Git —— 只连同目录一起忽略的话，data/README.md 要求的这份记录
# 就会永远提交不上去（踩过一次）。
!data/DATA_SOURCES.md
artifacts/*
!artifacts/README.md
!artifacts/.gitkeep
*.pth
*.pt
*.ckpt
*.onnx
*.om
*.rknn
*.engine
*.trt

# ── 运行输出 ─────────────────────────────────────────
runs/
outputs/
logs/
*.log

# ── 编辑器 / 系统 ────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
